# ---------------------------------------------------------------------------
# NVIDIA NIM — required
# Free key: https://build.nvidia.com/settings/api-keys  (starts with "nvapi-")
# On Vercel add this in Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional alias (either name works)
# NVIDIA_NIM_API_KEY=nvapi-...

# ---------------------------------------------------------------------------
# Optional overrides
# ---------------------------------------------------------------------------
# Base URL of the NVIDIA hosted API
# NVIDIA_API_BASE=https://ai.api.nvidia.com/v1
# NVCF endpoint used to poll async (202) jobs
# NVIDIA_NVCF_BASE=https://api.nvcf.nvidia.com/v2/nvcf

# 3D model (Microsoft TRELLIS NIM)
# NVIDIA_TRELLIS_MODEL=microsoft/trellis

# Text-to-image model used by the "Concept → 3D" pipeline
# black-forest-labs/flux.1-schnell  (default)  |  black-forest-labs/flux.1-dev
# NVIDIA_IMAGE_MODEL=black-forest-labs/flux.1-schnell

# Self-hosted TRELLIS NIM (skips the hosted gateway; no key required)
# NVIDIA_TRELLIS_INFER_URL=http://localhost:8000/v1/infer
